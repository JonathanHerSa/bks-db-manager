{
  "id": "t3zca-db-manager",
  "name": "DB Manager Pro",
  "version": "1.0.8",
  "minAppVersion": "5.4.0",
  "description": "Live stream cloning (A -> B), smart sanitization (strip DEFINER), schema diff, health auditor, mock data generator, data dictionary, and Docker/.env auto-discovery.",
  "author": {
    "name": "T3zcaDev",
    "url": "https://github.com/JonathanHerSa"
  },
  "icon": "storage",
  "manifestVersion": 1,
  "capabilities": {
    "views": [
      {
        "id": "t3zca-db-manager",
        "name": "DB Manager Pro",
        "type": "plain-tab",
        "entry": "dist/index.html"
      }
    ],
    "menu": [
      {
        "command": "open-db-manager-snapshots",
        "name": "DB Manager: Snapshots & Backups",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-clone",
        "name": "DB Manager: Stream Clone (A ➔ B)",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-diff",
        "name": "DB Manager: Schema Diff & Migrations",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-health",
        "name": "DB Manager: Health & Performance Auditor",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-mock",
        "name": "DB Manager: Mock Data Generator",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-docs",
        "name": "DB Manager: Data Dictionary",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-discovery",
        "name": "DB Manager: Auto-Discovery (Docker & .env)",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-table",
        "name": "DB Manager: Mock Data for this table",
        "view": "t3zca-db-manager",
        "placement": "entity.table.context"
      }
    ]
  },
  "permissions": []
}
