{
  "id": "bks-db-manager",
  "name": "DB Manager Pro",
  "version": "1.0.0",
  "minAppVersion": "5.4.0",
  "description": "Live stream cloning (A -> B), smart sanitization (strip DEFINER), schema diff, docker & .env discovery, and mock data generator.",
  "author": {
    "name": "T3zcaDev",
    "url": "https://github.com/JonathanHerSa"
  },
  "icon": "storage",
  "manifestVersion": 1,
  "capabilities": {
    "views": [
      {
        "id": "bks-db-manager",
        "name": "DB Manager Pro",
        "type": "shell-tab",
        "entry": "dist/index.html"
      }
    ],
    "menus": [
      {
        "command": "open-db-manager-tools",
        "name": "DB Manager Pro",
        "view": "bks-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-table",
        "name": "DB Manager Pro",
        "view": "bks-db-manager",
        "placement": "entity.table.context"
      }
    ]
  },
  "permissions": []
}
