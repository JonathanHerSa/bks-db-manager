{
  "id": "t3zca-db-manager",
  "name": "DB Manager Pro",
  "version": "1.0.2",
  "minAppVersion": "5.4.0",
  "description": "Live stream cloning (A -> B), smart sanitization (strip DEFINER), schema diff, docker & .env discovery, and mock data generator.",
  "author": {
    "name": "T3zcaDev",
    "url": "https://github.com/JonathanHerSa"
  },
  "icon": "storage",
  "manifestVersion": 1,
  "capabilities": {
    "views": [
      {
        "id": "t3zca-db-manager",
        "name": "DB Manager Pro",
        "type": "shell-tab",
        "entry": "dist/index.html"
      }
    ],
    "menu": [
      {
        "command": "open-db-manager-snapshots",
        "name": "DB Manager: Snapshots & Backups",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-clone",
        "name": "DB Manager: Clonado Stream (A ➔ B)",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-diff",
        "name": "DB Manager: Schema Diff & Migraciones",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-health",
        "name": "DB Manager: Auditor de Salud & Rendimiento",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-mock",
        "name": "DB Manager: Generador Mock Data",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-docs",
        "name": "DB Manager: Diccionario de Datos",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-discovery",
        "name": "DB Manager: Auto-Discovery (Docker & .env)",
        "view": "t3zca-db-manager",
        "placement": "menubar.tools"
      },
      {
        "command": "open-db-manager-table",
        "name": "DB Manager: Mock Data para esta tabla",
        "view": "t3zca-db-manager",
        "placement": "entity.table.context"
      }
    ]
  },
  "permissions": []
}
